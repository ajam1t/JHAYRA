# Copy this to .env.local and fill in your actual values
# Get these from: Supabase Dashboard → Project Settings → API
# NEVER commit .env.local — only this example file is safe to commit

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here

# Razorpay Key ID (PUBLIC — safe to commit)
# Get from: Razorpay Dashboard → Settings → API Keys
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxxxx

# NOTE: RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET are PRIVATE.
# NEVER put them here or in any frontend file.
# Store them ONLY in: Supabase Dashboard → Edge Functions → Secrets
